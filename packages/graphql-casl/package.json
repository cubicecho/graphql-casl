{
  "name": "@vantreeseba/graphql-casl",
  "version": "1.7.0",
  "description": "GraphQL middleware plugin for defining CASL permission rules on resolvers, with optional argument scoping and an envelop/Yoga integration.",
  "keywords": [
    "graphql",
    "graphql-middleware",
    "casl",
    "authorization",
    "permissions",
    "access-control",
    "rbac",
    "abac",
    "resolvers",
    "middleware",
    "typescript",
    "envelop",
    "graphql-yoga"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubicecho/graphql-casl.git",
    "directory": "packages/graphql-casl"
  },
  "homepage": "https://github.com/cubicecho/graphql-casl#readme",
  "bugs": {
    "url": "https://github.com/cubicecho/graphql-casl/issues"
  },
  "license": "MIT",
  "author": "Benjamin Van Treese <vantreeseba@gmail.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scoping": {
      "types": "./dist/scoping.d.ts",
      "import": "./dist/scoping.js"
    },
    "./envelop": {
      "types": "./dist/envelop.d.ts",
      "import": "./dist/envelop.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run bench/",
    "coverage": "vitest run --coverage",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "@casl/ability": ">=6",
    "@envelop/core": ">=5",
    "@envelop/on-resolve": ">=7",
    "graphql": ">=16",
    "graphql-middleware": ">=6"
  },
  "peerDependenciesMeta": {
    "@envelop/core": {
      "optional": true
    },
    "@envelop/on-resolve": {
      "optional": true
    }
  },
  "devDependencies": {
    "@casl/ability": "^7.0.0",
    "@envelop/core": "^5.6.0",
    "@envelop/on-resolve": "^7.0.0",
    "@envelop/testing": "^10.2.0",
    "@graphql-tools/schema": "^10.0.33",
    "graphql": "^16.14.0",
    "graphql-middleware": "^6.1.35",
    "zod": "^4.5.4"
  }
}
