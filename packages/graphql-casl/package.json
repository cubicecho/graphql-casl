{
  "name": "@vantreeseba/graphql-casl",
  "version": "1.1.0",
  "description": "GraphQL middleware plugin for defining CASL permission rules on resolvers.",
  "keywords": [
    "graphql",
    "graphql-middleware",
    "casl",
    "authorization",
    "permissions",
    "access-control",
    "rbac",
    "abac",
    "resolvers",
    "middleware",
    "typescript"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubicecho/graphql-casl.git",
    "directory": "packages/graphql-casl"
  },
  "homepage": "https://github.com/cubicecho/graphql-casl#readme",
  "bugs": {
    "url": "https://github.com/cubicecho/graphql-casl/issues"
  },
  "license": "MIT",
  "author": "Benjamin Van Treese <vantreeseba@gmail.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scoping": {
      "types": "./dist/scoping.d.ts",
      "import": "./dist/scoping.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "@casl/ability": ">=6",
    "graphql": ">=16",
    "graphql-middleware": ">=6"
  },
  "devDependencies": {
    "@casl/ability": "^7.0.0",
    "@graphql-tools/schema": "^10.0.33",
    "graphql": "^16.14.0",
    "graphql-middleware": "^6.1.35"
  }
}
